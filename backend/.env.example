# Server
PORT=4000
NODE_ENV=development

# Database (Postgres via Prisma)
DATABASE_URL="postgresql://myvault:myvault@localhost:5432/myvault?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# File storage
# Set STORAGE_DRIVER=local for dev (writes to ./uploads, no AWS needed)
# Set STORAGE_DRIVER=s3 in production
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=myvault-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
